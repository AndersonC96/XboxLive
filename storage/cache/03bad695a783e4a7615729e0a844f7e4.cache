00.0000000Z";s:23:"EligibilityPredicateIds";a:1:{i:0;s:23:"CannotSeenByChinaClient";}s:23:"SupportedCatalogVersion";i:7;}s:16:"LastModifiedDate";s:28:"2025-11-05T23:11:45.1441083Z";s:7:"Markets";a:1:{i:0;s:2:"US";}s:19:"OrderManagementData";a:3:{s:22:"GrantedEntitlementKeys";a:0:{}s:8:"PIFilter";a:2:{s:19:"ExclusionProperties";a:0:{}s:19:"InclusionProperties";a:0:{}}s:5:"Price";a:7:{s:12:"CurrencyCode";s:3:"USD";s:12:"IsPIRequired";b:0;s:9:"ListPrice";d:9.99;s:4:"MSRP";d:19.99;s:7:"TaxType";s:16:"TaxesNotIncluded";s:21:"WholesaleCurrencyCode";s:3:"USD";s:14:"WholesalePrice";d:6.99;}}s:10:"Properties";a:1:{s:19:"OriginalReleaseDate";s:28:"2022-03-15T04:00:00.0000000Z";}s:5:"SkuId";s:4:"0010";s:11:"DisplayRank";i:1;s:12:"AlternateIds";a:1:{i:0;a:2:{s:6:"IdType";s:21:"LegacyTokenIdentifier";s:5:"Value";s:36:"434b4e39-5a31-3034-c05a-3932564e3d00";}}s:14:"ProductASchema";s:9:"Product;3";}}}i:1;a:3:{s:3:"Sku";a:11:{s:16:"LastModifiedDate";s:28:"2026-04-02T16:30:03.7219041Z";s:19:"LocalizedProperties";a:1:{i:0;a:16:{s:12:"Contributors";a:0:{}s:8:"Features";a:0:{}s:12:"MinimumNotes";s:0:"";s:16:"RecommendedNotes";s:0:"";s:12:"ReleaseNotes";s:0:"";s:25:"DisplayPlatformProperties";N;s:14:"SkuDescription";s:3306:"Continue sua jornada no Xbox Series X|S realizando uma migração única para transferir tanto o seu progresso do Modo História do GTAV quanto seus personagens e progresso do GTA Online para o Xbox Series X|S.

Explore GTA Online, um universo online dinâmico em constante evolução para até 30 jogadores, onde você começa como um malandro de rua e pode se tornar o rei do seu próprio império do crime. 

Os jogadores de Xbox Series X|S podem aproveitar novas melhorias de desempenho em veículos e aprimoramentos como a opção de escolher uma carreira criminal, bem como todas as atualizações de jogo, expansões e conteúdo adicionados desde o lançamento do GTA Online prontos para jogar a sós ou com amigos. Coopere para realizar Golpes ousados, entre em Corridas Acrobáticas cheias de adrenalina, dispute em Modos Adversários exclusivos ou passe um tempo socializando em boates, fliperamas, festas em coberturas, eventos de carros e muito mais. 

GTA Online para Xbox Series X|S também vem com novos aprimoramentos, incluindo: 

•	NOVO CONTEÚDO EXCLUSIVO — Passe na Hao’s Special Works no Evento de Carros de Los Santos, que oferece melhorias de elite e modificações exclusivas. Depois, acelere com esses veículos potentes em Corridas HSW, novos Desafios Contra o Relógio e mais.
•	NOVA SELEÇÃO DE CARREIRAS — Comece em GTA Online com o capital em mãos. Escolha entre um dos quatro negócios – Motoqueiro, Executivo, Dono de Boate ou Traficante de Armas – e selecione propriedades, veículos potentes e armamento para dar o pontapé inicial no seu empreendimento.
•	NOVO DESIGN DO MENU — Acesse tudo o que GTA Online tem para oferecer diretamente no menu principal, incluindo as atualizações mais recentes e populares. 
•	ACESSO A TODAS AS ATUALIZAÇÕES RECENTES E ANTIGAS — Mergulhe em mais de 40 atualizações gigantes, além das que ainda estão por vir, incluindo tudo desde ajudar o Franklin Clinton na busca alucinada pelos arquivos de música desaparecidos do Dr. Dre em The Contract até as corridas de rua mais eletrizantes do submundo em Los Santos Tuners. Curta também Golpes na exuberante ilha tropical de Cayo Perico e os altos e baixos da vida noturna em Night na Balada e no Cassino e Resort Diamond. Tudo isso e muito mais, além de uma ampla variedade de corridas, modos, atividades e espaços de socialização para curtir por contra própria ou com os amigos – incluindo boates, fliperamas, festas em coberturas, eventos de carros e muito mais.

Além disso, todos os aprimoramentos disponíveis nas plataformas da nova geração levam o mundo de Los Santos e Blaine County até você em mais detalhes do que nunca, incluindo:

•	GRÁFICOS DESLUMBRANTES — Melhorias nos níveis de fidelidade e desempenho, incluindo novos modos gráficos com resolução de até 4K e 60 quadros por segundo, opções de HDR, raytracing, texturas aprimoradas e muito mais.
•	CARREGAMENTO MAIS RÁPIDO — Nunca foi tão rápido carregar o mundo de Los Santos e Blaine County, tendo acesso quase instantâneo à ação. 
•	SOM ESPACIAL — Ouça os sons do mundo com o máximo de precisão: o ronco do acelerador de um supercarro roubado, os disparos de tiros nas proximidades, o ruído de um helicóptero sobrevoando e mais.";s:8:"SkuTitle";s:23:"Grand Theft Auto Online";s:14:"SkuButtonTitle";s:0:"";s:19:"DeliveryDateOverlay";N;s:14:"SkuDisplayRank";a:1:{i:0;a:2:{s:9:"Dimension";s:0:"";s:4:"Rank";i:1;}}s:13:"TextResources";N;s:6:"Images";a:0:{}s:9:"LegalText";a:7:{s:22:"AdditionalLicenseTerms";s:0:"";s:9:"Copyright";s:0:"";s:12:"CopyrightUri";s:0:"";s:13:"PrivacyPolicy";s:0:"";s:16:"PrivacyPolicyUri";s:29:"www.rockstargames.com/privacy";s:3:"Tou";s:0:"";s:6:"TouUri";s:0:"";}s:8:"Language";s:5:"pt-br";s:7:"Markets";a:243:{i:0;s:2:"US";i:1;s:2:"DZ";i:2;s:2:"AR";i:3;s:2:"AU";i:4;s:2:"AT";i:5;s:2:"BH";i:6;s:2:"BD";i:7;s:2:"BE";i:8;s:2:"BR";i:9;s:2:"BG";i:10;s:2:"CA";i:11;s:2:"CL";i:12;s:2:"CN";i:13;s:2:"CO";i:14;s:2:"CR";i:15;s:2:"HR";i:16;s:2:"CY";i:17;s:2:"CZ";i:18;s:2:"DK";i:19;s:2:"EG";i:20;s:2:"EE";i:21;s:2:"FI";i:22;s:2:"FR";i:23;s:2:"DE";i:24;s:2:"GR";i:25;s:2:"GT";i:26;s:2:"HK";i:27;s:2:"HU";i:28;s:2:"IS";i:29;s:2:"IN";i:30;s:2:"ID";i:31;s:2:"IQ";i:32;s:2:"IE";i:33;s:2:"IL";i:34;s:2:"IT";i:35;s:2:"JP";i:36;s:2:"JO";i:37;s:2:"KZ";i:38;s:2:"KE";i:39;s:2:"KW";i:40;s:2:"LV";i:41;s:2:"LB";i:42;s:2:"LI";i:43;s:2:"LT";i:44;s:2:"LU";i:45;s:2:"MY";i:46;s:2:"MT";i:47;s:2:"MR";i:48;s:2:"MX";i:49;s:2:"MA";i:50;s:2:"NL";i:51;s:2:"NZ";i:52;s:2:"NG";i:53;s:2:"NO";i:54;s:2:"OM";i:55;s:2:"PK";i:56;s:2:"PE";i:57;s:2:"PH";i:58;s:2:"PL";i:59;s:2:"PT";i:60;s:2:"QA";i:61;s:2:"RO";i:62;s:2:"RU";i:63;s:2:"SA";i:64;s:2:"RS";i:65;s:2:"SG";i:66;s:2:"SK";i:67;s:2:"SI";i:68;s:2:"ZA";i:69;s:2:"KR";i:70;s:2:"ES";i:71;s:2:"SE";i:72;s:2:"CH";i:73;s:2:"TW";i:74;s:2:"TH";i:75;s:2:"TT";i:76;s:2:"TN";i:77;s:2:"TR";i:78;s:2:"UA";i:79;s:2:"AE";i:80;s:2:"GB";i:81;s:2:"VN";i:82;s:2:"YE";i:83;s:2:"LY";i:84;s:2:"LK";i:85;s:2:"UY";i:86;s:2:"VE";i:87;s:2:"AF";i:88;s:2:"AX";i:89;s:2:"AL";i:90;s:2:"AS";i:91;s:2:"AO";i:92;s:2:"AI";i:93