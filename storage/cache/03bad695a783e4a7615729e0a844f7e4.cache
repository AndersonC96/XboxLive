tifier";a:2:{s:9:"ListingId";s:19:"3000000000000000074";s:7:"AssetId";s:19:"1152922700009333607";}s:15:"BackgroundColor";s:7:"#FFFFFF";s:7:"Caption";s:0:"";s:15:"FileSizeInBytes";i:10088291;s:15:"ForegroundColor";s:7:"#FFFFFF";s:6:"Height";i:2160;s:17:"ImagePositionInfo";s:7:"Xbox/11";s:12:"ImagePurpose";s:10:"Screenshot";s:23:"UnscaledImageSHA256Hash";s:44:"qCo7EJyasqegexk6Lid1cT2gJv5ChoJgdqtza4ONCao=";s:3:"Uri";s:139:"//store-images.s-microsoft.com/image/apps.10920.14492969036550054.60600288-08e8-4d23-a3d1-308fda591bd6.f28fc3d4-10c1-4798-be1a-103b0cf47ede";s:5:"Width";i:3840;}}s:6:"Videos";a:0:{}s:18:"ProductDescription";s:1011:"Continue sua jornada no Xbox Series X|S realizando uma migração única para transferir tanto o seu progresso do Modo História do GTAV quanto seus personagens e progresso do GTA Online para o Xbox Series X|S. 

Experimente os fenômenos do entretenimento Grand Theft Auto V e GTA Online: agora no Xbox Series X|S. 

Quando um tratante inexperiente, um ladrão de bancos aposentado e um psicopata aterrorizante se envolvem com algumas das figuras mais assustadoras e problemáticas do submundo do crime, do governo dos EUA e da indústria do entretenimento, eles precisam realizar uma série de golpes ousados para sobreviver em uma cidade implacável onde não podem confiar em ninguém, nem mesmo um no outro.

Suba na hierarquia do crime por si só ou com amigos em GTA Online: execute Golpes cooperativos, inicie esquemas criminosos, participe de Corridas Acrobáticas cheias de adrenalina, dispute Modos Adversários e muito mais. Inclui acesso a todas as atualizações de conteúdo atuais e anteriores. ";s:12:"ProductTitle";s:36:"Grand Theft Auto V (Xbox Series X|S)";s:10:"ShortTitle";s:22:"GTAV (Xbox Series X|S)";s:9:"SortTitle";s:36:"Grand Theft Auto V (Xbox Series X|S)";s:13:"FriendlyTitle";N;s:16:"ShortDescription";s:126:"Experimente os fenômenos Grand Theft Auto V: Modo História e Grand Theft Auto Online, agora com mais detalhes do que nunca. ";s:12:"SearchTitles";a:0:{}s:10:"VoiceTitle";s:36:"Grand Theft Auto V (Xbox Series X|S)";s:18:"RenderGroupDetails";N;s:19:"ProductDisplayRanks";a:0:{}s:22:"InteractiveModelConfig";N;s:20:"Interactive3DEnabled";b:0;s:8:"Language";s:5:"pt-br";s:7:"Markets";a:243:{i:0;s:2:"US";i:1;s:2:"DZ";i:2;s:2:"AR";i:3;s:2:"AU";i:4;s:2:"AT";i:5;s:2:"BH";i:6;s:2:"BD";i:7;s:2:"BE";i:8;s:2:"BR";i:9;s:2:"BG";i:10;s:2:"CA";i:11;s:2:"CL";i:12;s:2:"CN";i:13;s:2:"CO";i:14;s:2:"CR";i:15;s:2:"HR";i:16;s:2:"CY";i:17;s:2:"CZ";i:18;s:2:"DK";i:19;s:2:"EG";i:20;s:2:"EE";i:21;s:2:"FI";i:22;s:2:"FR";i:23;s:2:"DE";i:24;s:2:"GR";i:25;s:2:"GT";i:26;s:2:"HK";i:27;s:2:"HU";i:28;s:2:"IS";i:29;s:2:"IN";i:30;s:2:"ID";i:31;s:2:"IQ";i:32;s:2:"IE";i:33;s:2:"IL";i:34;s:2:"IT";i:35;s:2:"JP";i:36;s:2:"JO";i:37;s:2:"KZ";i:38;s:2:"KE";i:39;s:2:"KW";i:40;s:2:"LV";i:41;s:2:"LB";i:42;s:2:"LI";i:43;s:2:"LT";i:44;s:2:"LU";i:45;s:2:"MY";i:46;s:2:"MT";i:47;s:2:"MR";i:48;s:2:"MX";i:49;s:2:"MA";i:50;s:2:"NL";i:51;s:2:"NZ";i:52;s:2:"NG";i:53;s:2:"NO";i:54;s:2:"OM";i:55;s:2:"PK";i:56;s:2:"PE";i:57;s:2:"PH";i:58;s:2:"PL";i:59;s:2:"PT";i:60;s:2:"QA";i:61;s:2:"RO";i:62;s:2:"RU";i:63;s:2:"SA";i:64;s:2:"RS";i:65;s:2:"SG";i:66;s:2:"SK";i:67;s:2:"SI";i:68;s:2:"ZA";i:69;s:2:"KR";i:70;s:2:"ES";i:71;s:2:"SE";i:72;s:2:"CH";i:73;s:2:"TW";i:74;s:2:"TH";i:75;s:2:"TT";i:76;s:2:"TN";i:77;s:2:"TR";i:78;s:2:"UA