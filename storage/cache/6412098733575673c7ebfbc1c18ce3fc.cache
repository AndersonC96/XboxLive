O";i:5;s:8:"GANYMEDE";}s:19:"supportedInputTypes";a:2:{i:0;s:10:"Controller";i:1;s:3:"MKB";}s:13:"supportsTouch";b:0;}s:21:"isAvailableOnGarrison";b:1;s:33:"hasUbisoftCrossEntitlementProduct";b:0;}i:19;a:29:{s:11:"availableOn";a:2:{i:0;s:11:"XboxSeriesX";i:1;s:6:"XCloud";}s:13:"averageRating";d:3.7;s:6:"badges";a:3:{i:0;a:1:{s:4:"type";i:3;}i:1;a:1:{s:4:"type";i:9;}i:2;a:1:{s:4:"type";i:7;}}s:10:"categories";a:1:{i:0;s:8:"Esportes";}s:13:"contentRating";a:10:{s:9:"boardName";s:5:"DJCTQ";s:11:"description";s:23:"Para maiores de 18 anos";s:11:"disclaimers";a:0:{}s:11:"descriptors";a:1:{i:0;s:20:"Linguagem Imprópria";}s:8:"imageUri";s:135:"https://store-images.s-microsoft.com/image/global.23550.image.72c09ff9-10b2-4747-97c4-39bea6303a50.dd7f8ed7-30f2-4e25-a392-845324fa6025";s:12:"imageLinkUri";s:66:"https://www.gov.br/mj/pt-br/assuntos/seus-direitos/classificacao-1";s:23:"interactiveDescriptions";a:2:{i:0;s:19:"Usuários Interagem";i:1;s:42:"Compras on-line (Inclui itens aleatórios)";}s:6:"rating";s:7:"18 anos";s:9:"ratingAge";i:18;s:17:"ratingDescription";s:23:"Para maiores de 18 anos";}s:11:"description";s:2555:"Domine tudo no NBA 2K26. Faça seu nome no MyCAREER, entre no jogo com lendas no MyTEAM e mostre que entende de gestão no MyNBA (Xbox Series X|S) ou MyLEAGUE (Xbox One).

IMPULSIONADO POR ProPLAY™

Domine cada posse de bola com uma tecnologia imersiva que transforma lances reais da NBA em jogabilidade autêntica no Xbox Series X|S. Sinta a diferença em cada drible e finta, e jogue com liberdade total usando os novos recursos de criação de jogadas.

MONTE UM TIME PARA VENCER

Crie um MyPLAYER que vai além das quadras no MyCAREER e trilhe o caminho de talento promissor a fenômeno mundial. Explore cenários incríveis, jogue ao lado dos amigos e enfrente equipes rivais para mostrar quem manda no pedaço.

REÚNA ESTRELAS NO MyTEAM

Colecione lendas da velha guarda e dos atuais astros da NBA no MyTEAM. Monte um elenco imbatível, teste seu time dos sonhos nos modos para um jogador e multijogador, e adquira novas cartas para deixar seu MyTEAM do jeito que sempre imaginou.

SEU TIME, SEU LEGADO

Assuma o papel de Gerente Geral e escreva o próximo capítulo de uma franquia da NBA no MyNBA (Xbox Series X|S) ou no MyLEAGUE (Xbox One). Decida o rumo da liga e deixe sua marca no futuro do esporte.
*O resgate do conteúdo bônus requer conexão com a internet e uma Conta NBA 2K. Os termos se aplicam.

Alguns recursos do jogo, como o modo multijogador online, comunicação e outros recursos online, podem não estar disponíveis para contas infantis do Xbox. No Xbox, considera-se criança jogadores com menos de 13 anos, a menos que as leis locais indiquem o contrário. O Play Now, MyLEAGUE e WNBA estão disponíveis offline.

A compra garante a licença do produto digital, sujeito aos Termos de Serviço (“TdS”) e à Política de Privacidade, disponíveis no jogo e em www.take2games.com/legal e www.take2games.com/privacy. O acesso a recursos especiais, bônus, conteúdos, serviços ou funções online (“Recursos Especiais”) pode requerer um código serial de uso único, taxa adicional, registro de conta online e/ou pode não estar disponível para contas registradas por usuários com menos de 13 anos (a idade mínima varia). Os recursos especiais podem precisar de internet, não estar disponíveis o tempo todo para todos os usuários e podem ser modificados, encerrados ou oferecidos sob outros termos, conforme os TdS. Consulte https://bit.ly/2K-Online-Services-Status para verificar sua disponibilidade. O descumprimento dos TdS pode resultar em restrição ou encerramento do acesso ao jogo ou à conta online.";s:13:"developerName";s:15:"Visual Concepts";s:9:"hasAddOns";b:1;s:6:"images";a:3:{s:6:"boxArt";a:3:{s:3:"url";s:145:"https://store-images.s-microsoft.com/image/apps.50564.13597880418237927.1db3ecc3-d73b-4573-a4d1-d16bd9922438.652f42d1-6d0d-4c1d-a65f-e42e3cd2a7a9";s:5:"width";i:2160;s:6:"height";i:2160;}s:6:"poster";a:3:{s:3:"url";s:145:"https://store-images.s-microsoft.com/image/apps.23652.13597880418237927.1db3ecc3-d73b-4573-a4d1-d16bd9922438.69561e2d-167c-4608-b5f0-287c10e2e5d5";s:5:"width";i:1440;s:6:"height";i:2160;}s:12:"superHeroArt";a:3:{s:3:"url";s:145:"https://store-images.s-microsoft.com/image/apps.64882.13597880418237927.1db3ecc3-d73b-4573-a4d1-d16bd9922438.024fcdb2-3b80-4f63-9bf3-43b98235264c";s:5:"width";i:3840;s:6:"height";i:2160;}}s:28:"includedWithPassesProductIds";a:3:{i:0;s:12:"CFQ7TTC0HX8W";i:1;s:12:"CFQ7TTC0K6L8";i:2;s:12:"CFQ7TTC0P85B";}s:14:"maxInstallSize";i:0;s:23:"optimalSatisfyingPassId";s:12:"CFQ7TTC0HX8W";s:14:"preferredSkuId";s:4:"0010";s:13:"productFamily";s:5:"Games";s:9:"productId";s:12:"9NFKCJNBR34N";s:11:"productKind";s:4:"Game";s:13:"publisherName";s:2:"2K";s:11:"ratingC